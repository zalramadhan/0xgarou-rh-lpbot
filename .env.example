# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Wallet that owns the LP positions. Leave empty for read-only monitoring.
# WARNING: a hot wallet key on a server can be drained if the host is compromised.
PRIVATE_KEY=

# Robinhood Chain (chainId 4663) RPC. Public fallback works but rate limits.
RPC_URL=https://robinhood.drpc.org

# Comma separated Telegram chat ids allowed to use the bot.
# Leave empty to let the first chat that sends /start claim the bot.
ALLOWED_CHAT_IDS=

# Safety switch. true = build + simulate transactions without broadcasting.
DRY_RUN=true

# Where tracked positions/settings live.
DB_PATH=data/store.json

# Encrypted keystore written by /importwallet (scrypt + AES-256-GCM).
KEYSTORE_PATH=data/keystore.json

# Max concurrent RPC requests. Public RPCs choke on bursts; 4 is a safe default.
RPC_MAX_CONCURRENCY=4

# Monitoring loop interval in ms.
POLL_INTERVAL_MS=15000

# 0x Swap API key (routes the auto-swap; without it the v3 route is used)
ZEROX_API_KEY=

# GMGN (optional). The API key is enough for queries; the private key is only
# needed if GMGN should ever execute a swap for you. Never commit either.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
GMGN_API_URL=https://openapi.gmgn.ai
# The Callout API uses AK/SK HMAC-SHA256 credentials instead of a plain key.

# Default slippage tolerance in percent, used for min amounts on mint/close.
DEFAULT_SLIPPAGE_PCT=1

# Optional: explorer base url for tx links.
EXPLORER_URL=https://robinhoodchain.blockscout.com

# /detect — how the bot finds the LP NFTs a wallet holds.
# true  = use the RPC's NFT index (Alchemy's alchemy_getAssetTransfers): seconds.
# false = walk every minted v4 id on-chain with multicall3: exact, but minutes.
DETECT_USE_INDEXER=true

# How many v4 token ids the on-chain fallback walks before it gives up.
DETECT_SCAN_LIMIT=4000000
